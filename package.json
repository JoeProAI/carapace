{
  "name": "carapax",
  "version": "0.1.1",
  "description": "Carapax: a deterministic memory-integrity firewall for memory-first agents. The shell around your agent's brain.",
  "type": "module",
  "license": "MIT",
  "author": "JoeProAI",
  "homepage": "https://github.com/JoeProAI/carapace#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JoeProAI/carapace.git"
  },
  "bugs": {
    "url": "https://github.com/JoeProAI/carapace/issues"
  },
  "keywords": [
    "ai-agents",
    "agent-security",
    "memory-security",
    "prompt-injection",
    "openclaw",
    "mem0"
  ],
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./adapters/mem0": {
      "types": "./dist/adapters/mem0.d.ts",
      "import": "./dist/adapters/mem0.js",
      "default": "./dist/adapters/mem0.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke:package": "npm run build && node scripts/package-smoke.mjs",
    "verify": "npm run typecheck && npm test && npm run smoke:package",
    "prepack": "npm run build && node scripts/package-smoke.mjs",
    "demo": "tsx examples/demo.ts",
    "redteam": "tsx examples/redteam.ts",
    "bench": "tsx bench/run.ts",
    "measure:model": "tsx bench/measure-model.ts",
    "adapter:demo": "tsx examples/mem0-adapter.ts"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsx": "^4.23.13",
    "typescript": "^5.7.0",
    "vitest": "^3.2.7"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "release": {
      "publishToNpm": false
    }
  }
}
